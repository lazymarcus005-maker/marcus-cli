{
  "name": "macus-code",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first CLI coding agent powered by Pi",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "bin": {
    "macus": "./dist/src/cli.js"
  },
  "files": [
    "dist/src/**",
    "README.md",
    "docs/benchmark-protocol.md",
    "docs/configuration.md",
    "docs/dependency-attribution.md",
    "docs/implementation-map.md",
    "docs/phase-*.md",
    "docs/pi-compatibility.md",
    "docs/THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/**/*.test.ts",
    "benchmark:fixture": "tsx scripts/create-benchmark-fixture.ts",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "ignore": "7.0.5",
    "tree-sitter": "0.21.1",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-typescript": "0.23.2",
    "typebox": "1.3.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
